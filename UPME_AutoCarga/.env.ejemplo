# Archivo de credenciales de Bizagi para UPME AutoCarga.
# Copie este archivo, renómbrelo (p. ej. credenciales.env), complete los
# valores y compártalo por un medio privado. Cada usuario lo carga con
# "Importar credenciales..." en el programa. NUNCA lo suba a GitHub.
BIZAGI_USER_NEW='usuario@empresa.com'
BIZAGI_PASSWORD_NEW='contraseña'
